+    // The jump-table cap is a codegen cvar rather than a config field. A
+    // manifest that names it (Crackdown 2 needs 519: one of its switch tables
+    // has 518 entries, and a truncated table traps at run time) applies it
+    // unless the command line already set it.
+    if (auto v = (*analysisTable)["max_jump_table_entries"].value<uint32_t>()) {
+      if (rex::cvar::GetFlagSource("max_jump_table_entries") != rex::cvar::Source::kCommandLine) {
+        // The cvar is init-only and flags are finalised before the manifest is
