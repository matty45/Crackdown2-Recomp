--- a/src/graphics/shared_memory.cpp
+++ b/src/graphics/shared_memory.cpp
@@ -20,8 +20,63 @@
 #include <rex/math.h>
 #include <rex/memory.h>
 
+#include <atomic>
+
+#include <rex/cvar.h>
+#include <rex/chrono/clock.h>
+
+REXCVAR_DEFINE_INT32(gpu_invalidation_widen_kb, 256, "GPU",
+                     "When the CPU writes to a page the GPU has data from, invalidate (and "
+                     "later re-upload) up to this many KB around the write instead of only the "
+                     "touched page. Larger values mean fewer access violations on the CPU side "
+                     "but more GPU uploads; 0 or the page size disables widening.")
+    .range(0, 4096)
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+REXCVAR_DEFINE_BOOL(gpu_log_shared_memory_stats, false, "GPU",
+                    "Log GPU shared memory upload and invalidation rates every few seconds.")
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+
 namespace rex::graphics {
 
+namespace {
+std::atomic<uint64_t> g_upload_bytes{0};
+std::atomic<uint64_t> g_upload_calls{0};
+std::atomic<uint64_t> g_invalidations{0};
+std::atomic<uint64_t> g_invalidated_bytes{0};
+std::atomic<uint64_t> g_request_calls{0};
+}  // namespace
+
+void SharedMemory::NoteUploadBytes(uint64_t bytes) {
+  g_upload_bytes.fetch_add(bytes, std::memory_order_relaxed);
+  g_upload_calls.fetch_add(1, std::memory_order_relaxed);
+}
+
+void SharedMemory::LogStatsIfDue() {
+  if (!REXCVAR_GET(gpu_log_shared_memory_stats)) {
+    return;
+  }
+  static uint64_t last_log_ms = 0;
+  uint64_t now_ms = rex::chrono::Clock::QueryHostUptimeMillis();
+  if (!last_log_ms) {
+    last_log_ms = now_ms;
+    return;
+  }
+  uint64_t dt = now_ms - last_log_ms;
+  if (dt < 5000) {
+    return;
+  }
+  last_log_ms = now_ms;
+  double secs = double(dt) / 1000.0;
+  uint64_t ub = g_upload_bytes.exchange(0), uc = g_upload_calls.exchange(0),
+           inv = g_invalidations.exchange(0), ib = g_invalidated_bytes.exchange(0),
+           rq = g_request_calls.exchange(0);
+  REXGPU_INFO(
+      "Shared memory stats: {:.1f} MB/s uploaded in {:.0f} uploads/s ({:.0f} requests/s); "
+      "{:.0f} CPU invalidations/s covering {:.1f} MB/s (widen {} KB)",
+      double(ub) / (1024.0 * 1024.0) / secs, double(uc) / secs, double(rq) / secs,
+      double(inv) / secs, double(ib) / (1024.0 * 1024.0) / secs, REXCVAR_GET(gpu_invalidation_widen_kb));
+}
+
 SharedMemory::SharedMemory(memory::Memory& memory) : memory_(memory) {
   page_size_log2_ = rex::log2_ceil(uint32_t(rex::memory::page_size()));
 }
