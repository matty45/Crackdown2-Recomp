+void D3D12CommandProcessor::AsyncMemexportReadbackRecordFrame() {
+  std::vector<draw_util::MemExportRange>& ranges = async_memexport_frame_ranges_;
+  if (ranges.empty()) {
+    return;
+  }
+
+  // Coalesce the frame's ranges (the same buffers are exported to by many
+  // draws) so one copy per distinct region is recorded.
+  std::sort(ranges.begin(), ranges.end(),
+            [](const draw_util::MemExportRange& a, const draw_util::MemExportRange& b) {
+              return a.base_address_dwords < b.base_address_dwords;
+            });
+  std::vector<draw_util::MemExportRange> merged;
+  merged.reserve(ranges.size());
+  for (const draw_util::MemExportRange& range : ranges) {
+    uint32_t begin = range.base_address_dwords << 2;
+    uint32_t end = begin + range.size_bytes;
+    if (!merged.empty()) {
+      draw_util::MemExportRange& last = merged.back();
+      uint32_t last_begin = last.base_address_dwords << 2;
+      uint32_t last_end = last_begin + last.size_bytes;
+      if (begin <= last_end) {
+        if (end > last_end) {
+          last.size_bytes = end - last_begin;
+        }
+        continue;
+      }
+    }
+    merged.push_back(range);
+  }
+  ranges.clear();
+
+  uint64_t total_size = 0;
+  for (const draw_util::MemExportRange& range : merged) {
+    total_size += range.size_bytes;
+  }
+  if (!total_size || total_size > kAsyncMemexportMaxBytes) {
+    return;
+  }
+
+  AsyncMemexportSlot& slot = async_memexport_slots_[async_memexport_slot_next_];
+  if (slot.pending && slot.submission_written > submission_completed_) {
+    // The GPU is more than kAsyncMemexportSlots frames behind - never stall,
+    // just drop this frame's readback; the guest keeps the last delivered data.
+    return;
+  }
+
+  uint32_t needed_size = AlignReadbackBufferSize(uint32_t(total_size));
+  if (!slot.buffer || slot.size < needed_size) {
+    if (slot.buffer) {
+      // Not pending (consumed, so completed) or completed - safe to release.
+      if (slot.mapped_data) {
+        slot.buffer->Unmap(0, nullptr);
+      }
+      slot.buffer->Release();
+      slot.buffer = nullptr;
+      slot.mapped_data = nullptr;
+      slot.size = 0;
+    }
+    const ui::d3d12::D3D12Provider& provider = GetD3D12Provider();
+    ID3D12Device* device = provider.GetDevice();
+    D3D12_RESOURCE_DESC buffer_desc;
+    ui::d3d12::util::FillBufferResourceDesc(buffer_desc, needed_size, D3D12_RESOURCE_FLAG_NONE);
+    ID3D12Resource* buffer = nullptr;
+    if (FAILED(device->CreateCommittedResource(
+            &ui::d3d12::util::kHeapPropertiesReadback, provider.GetHeapFlagCreateNotZeroed(),
+            &buffer_desc, D3D12_RESOURCE_STATE_COPY_DEST, nullptr, IID_PPV_ARGS(&buffer)))) {
+      REXGPU_ERROR("Failed to create a {} MB async memexport readback buffer", needed_size >> 20);
+      return;
+    }
+    D3D12_RANGE read_range = {0, needed_size};
+    void* mapped_data = nullptr;
+    if (FAILED(buffer->Map(0, &read_range, &mapped_data))) {
+      buffer->Release();
+      REXGPU_ERROR("Failed to map the async memexport readback buffer");
+      return;
+    }
+    slot.buffer = buffer;
+    slot.mapped_data = mapped_data;
+    slot.size = needed_size;
+  }
+
+  shared_memory_->UseAsCopySource();
+  SubmitBarriers();
+  ID3D12Resource* shared_memory_buffer = shared_memory_->GetBuffer();
+  uint32_t readback_offset = 0;
+  for (const draw_util::MemExportRange& range : merged) {
+    deferred_command_list_.D3DCopyBufferRegion(slot.buffer, readback_offset, shared_memory_buffer,
+                                               range.base_address_dwords << 2, range.size_bytes);
+    readback_offset += range.size_bytes;
+  }
+  slot.ranges = std::move(merged);
+  slot.submission_written = submission_current_;
+  slot.pending = true;
+  async_memexport_slot_next_ = (async_memexport_slot_next_ + 1) % kAsyncMemexportSlots;
+}
+
+void D3D12CommandProcessor::AsyncMemexportReadbackConsumeCompleted() {
+  AsyncMemexportSlot* newest = nullptr;
+  for (AsyncMemexportSlot& slot : async_memexport_slots_) {
+    if (slot.pending && slot.submission_written <= submission_completed_ &&
+        (!newest || slot.submission_written > newest->submission_written)) {
+      newest = &slot;
+    }
+  }
+  if (!newest) {
+    return;
+  }
+  const uint8_t* readback_bytes = static_cast<const uint8_t*>(newest->mapped_data);
+  for (const draw_util::MemExportRange& range : newest->ranges) {
+    void* guest = memory_->TranslatePhysical(range.base_address_dwords << 2);
+    if (guest) {
+      std::memcpy(guest, readback_bytes, range.size_bytes);
+    }
+    readback_bytes += range.size_bytes;
+  }
+  // Older completed slots are superseded by the newest one.
+  for (AsyncMemexportSlot& slot : async_memexport_slots_) {
+    if (slot.pending && slot.submission_written <= submission_completed_) {
+      slot.pending = false;
+    }
+  }
+}
+
+void D3D12CommandProcessor::AsyncMemexportReadbackShutdown() {
+  for (AsyncMemexportSlot& slot : async_memexport_slots_) {
+    if (slot.buffer) {
+      if (slot.mapped_data) {
+        slot.buffer->Unmap(0, nullptr);
+      }
+      slot.buffer->Release();
+    }
+    slot = AsyncMemexportSlot();
+  }
+  async_memexport_slot_next_ = 0;
+  async_memexport_frame_ranges_.clear();
+}
