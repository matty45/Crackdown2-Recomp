+void VulkanPipelineCache::LoadDriverPipelineCache(const std::filesystem::path& path) {
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  std::vector<uint8_t> data;
+  if (FILE* f = rex::filesystem::OpenFile(path, "rb")) {
+    std::fseek(f, 0, SEEK_END);
+    long size = std::ftell(f);
+    std::fseek(f, 0, SEEK_SET);
+    if (size > 0) {
+      data.resize(size_t(size));
+      if (std::fread(data.data(), 1, data.size(), f) != data.size()) {
+        data.clear();
+      }
+    }
+    std::fclose(f);
+  }
+  VkPipelineCacheCreateInfo create_info = {VK_STRUCTURE_TYPE_PIPELINE_CACHE_CREATE_INFO};
+  create_info.initialDataSize = data.size();
+  create_info.pInitialData = data.empty() ? nullptr : data.data();
+  // The driver validates the header (vendor, device, pipeline cache UUID) and
+  // ignores data from another GPU or driver version.
+  if (dfn.vkCreatePipelineCache(device, &create_info, nullptr, &driver_pipeline_cache_) !=
+      VK_SUCCESS) {
+    create_info.initialDataSize = 0;
+    create_info.pInitialData = nullptr;
+    if (dfn.vkCreatePipelineCache(device, &create_info, nullptr, &driver_pipeline_cache_) !=
+        VK_SUCCESS) {
+      driver_pipeline_cache_ = VK_NULL_HANDLE;
+      return;
+    }
+  }
+  driver_pipeline_cache_path_ = path;
+  driver_pipeline_cache_new_pipelines_ = 0;
+  driver_pipeline_cache_last_save_ms_ = rex::chrono::Clock::QueryHostUptimeMillis();
+  REXGPU_INFO("VulkanPipelineCache: driver pipeline cache {} ({} bytes loaded)",
+              rex::path_to_utf8(path), data.size());
+}
+
+void VulkanPipelineCache::SaveDriverPipelineCache(bool force) {
+  if (driver_pipeline_cache_ == VK_NULL_HANDLE || !driver_pipeline_cache_new_pipelines_) {
+    return;
+  }
+  uint64_t now_ms = rex::chrono::Clock::QueryHostUptimeMillis();
+  // Android usually kills the process instead of shutting it down, so also
+  // save while running, at most once a minute.
+  if (!force && now_ms - driver_pipeline_cache_last_save_ms_ < 60000) {
+    return;
+  }
+  driver_pipeline_cache_last_save_ms_ = now_ms;
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  size_t size = 0;
+  if (dfn.vkGetPipelineCacheData(device, driver_pipeline_cache_, &size, nullptr) != VK_SUCCESS ||
+      !size) {
+    return;
+  }
+  std::vector<uint8_t> data(size);
+  if (dfn.vkGetPipelineCacheData(device, driver_pipeline_cache_, &size, data.data()) !=
+      VK_SUCCESS) {
+    return;
+  }
+  uint32_t saved_new = driver_pipeline_cache_new_pipelines_.exchange(0);
+  std::error_code ec;
+  std::filesystem::create_directories(driver_pipeline_cache_path_.parent_path(), ec);
+  auto temp_path = driver_pipeline_cache_path_;
+  temp_path += ".tmp";
+  if (FILE* f = rex::filesystem::OpenFile(temp_path, "wb")) {
+    bool ok = std::fwrite(data.data(), 1, size, f) == size;
+    ok = (std::fclose(f) == 0) && ok;
+    if (ok) {
+      std::filesystem::rename(temp_path, driver_pipeline_cache_path_, ec);
+      REXGPU_INFO("VulkanPipelineCache: saved driver pipeline cache ({} bytes, {} new pipelines)",
+                  size, saved_new);
+    }
+  }
+}
