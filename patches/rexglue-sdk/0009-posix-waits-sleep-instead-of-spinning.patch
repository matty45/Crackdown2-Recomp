+// Wake-up for WaitMultiple: every signal of a waitable object bumps a global
+// generation and, if any multi-wait is blocked, notifies it. A multi-wait then
+// re-checks its handles immediately instead of polling every millisecond.
+std::atomic<uint64_t> g_any_signal_generation{0};
+std::atomic<int> g_multi_waiters{0};
+std::mutex g_any_signal_mutex;
+std::condition_variable g_any_signal_cond;
+
+void NotifyAnyWaiter() {
+  g_any_signal_generation.fetch_add(1, std::memory_order_acq_rel);
+  if (g_multi_waiters.load(std::memory_order_acquire)) {
+    std::lock_guard<std::mutex> lock(g_any_signal_mutex);
+    g_any_signal_cond.notify_all();
+  }
+}
